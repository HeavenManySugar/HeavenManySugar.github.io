---
import MotionWrapper from "../components/MotionWrapper";
import PageLayout from "../layouts/PageLayout.astro";
const containerVariants = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: {
      staggerChildren: 0.12,
      delayChildren: 0.2,
    },
  },
};

const itemVariants = {
  hidden: { y: 12, opacity: 0 },
  visible: {
    y: 0,
    opacity: 1,
    transition: {
      duration: 0.6,
      ease: [0.25, 0.46, 0.45, 0.94] as const,
    },
  },
};

const educationItems = [
  {
    year: "2021-2025",
    title: "國立臺北科技大學",
    subtitle: "資訊工程學系 四年級",
    description:
      "學習軟體工程、資料結構、演算法與人工智慧，積極參與系學會活動。",
  },
  {
    year: "2018-2021",
    title: "國立臺南高級工業職業學校",
    subtitle: "資訊科",
    description: "奠定程式設計基礎，擔任網頁設計社副社長。",
  },
];

const awards = [
  {
    title: "教育部全國大專院校人工智慧競賽",
    subtitle: "根據區域微氣候資料預測發電量",
    award: "佳作 - 第9名 / 934隊",
    year: "2024",
  },
  {
    title: "全國高級中等學校技藝競賽",
    subtitle: "工業類 電腦軟體設計",
    award: "優勝 - 第17名",
    year: "2021",
  },
  {
    title: "T貓盃全國資安基礎實務能力競賽",
    subtitle: "高中職組",
    award: "冠軍 - 第1名",
    year: "2021",
  },
];

const techStack = [
  {
    title: "前端開發",
    skills: ["React", "Next.js", "TypeScript", "Tailwind CSS"],
    description: "深入學習現代前端技術棧，專注於組件化開發與性能優化。",
  },
  {
    title: "後端開發",
    skills: ["Node.js", "Express.js", "Golang", "PostgreSQL"],
    description: "掌握後端開發，能夠獨立完成全端專案。",
  },
  {
    title: "設計思維",
    skills: ["Figma", "Design System", "UX/UI", "Prototyping"],
    description: "注重使用者體驗，實現技術與設計的完美結合。",
  },
  {
    title: "人工智慧",
    skills: ["Python", "Machine Learning", "TensorFlow", "Data Analysis"],
    description: "透過實際競賽深入學習機器學習與深度學習技術。",
  },
];
---

<PageLayout
  title="關於我 | 張睿恩 (Rui-En Zhang)"
  description="了解張睿恩的個人背景、教育經歷、專業技能與獲獎記錄"
>
  {/* 頂部 Hero 區塊 */}
  <section
    class="container mx-auto px-6 lg:px-8 py-24 md:py-32 border-b border-gray-200 dark:border-gray-800"
  >
    <MotionWrapper
      client:load
      className="max-w-2xl"
      variants={containerVariants}
      initial="hidden"
      animate="visible"
    >
      <MotionWrapper
        client:load
        type="h1"
        className="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white leading-tight mb-6"
        variants={itemVariants}
      >
        關於我
      </MotionWrapper>
      <MotionWrapper
        client:load
        type="p"
        className="text-xl text-gray-600 dark:text-gray-400 leading-relaxed mb-8 max-w-xl lxgw-wenkai-mono-tc-regular"
        variants={itemVariants}
      >
        我是張睿恩，一位對程式設計充滿熱忱的開發者。從高職到大學，我不斷精進技術能力，並在各項競賽中取得優異成績。相信技術與設計的完美結合能創造出優秀的使用者體驗。
      </MotionWrapper>
    </MotionWrapper>
  </section>

  {/* 基本資訊卡片 */}
  <section class="container mx-auto px-6 lg:px-8 py-12">
    <MotionWrapper
      client:load
      className="grid md:grid-cols-3 gap-6 max-w-4xl"
      variants={containerVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true }}
    >
      {
        [
          { label: "學校", value: "國立臺北科技大學" },
          { label: "系別", value: "資訊工程學系" },
          { label: "年級", value: "四年級" },
        ].map((item) => (
          <MotionWrapper
            client:load
            key={item.label}
            variants={itemVariants}
            className="bg-gray-50 dark:bg-gray-900 p-6 rounded-lg border border-gray-200 dark:border-gray-800"
          >
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
              {item.label}
            </p>
            <p class="text-lg font-semibold text-gray-900 dark:text-white">
              {item.value}
            </p>
          </MotionWrapper>
        ))
      }
    </MotionWrapper>
  </section>

  {/* 教育背景 */}
  <section class="container mx-auto px-6 lg:px-8 py-12">
    <MotionWrapper
      client:idle
      className="max-w-4xl"
      variants={containerVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true }}
    >
      <MotionWrapper
        client:idle
        type="h2"
        className="text-4xl font-bold text-gray-900 dark:text-white mb-12"
        variants={itemVariants}
      >
        教育背景
      </MotionWrapper>
      <div class="space-y-6">
        {
          educationItems.map((item, i) => (
            <div>
              <MotionWrapper
                client:visible
                key={i}
                variants={itemVariants}
                className="flex gap-6 pb-6 border-b border-gray-200 dark:border-gray-800 last:border-b-0"
              >
                <div class="text-sm font-semibold text-blue-600 dark:text-blue-400 min-w-fit">
                  {item.year}
                </div>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">
                    {item.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                    {item.subtitle}
                  </p>
                  <p class="text-gray-600 dark:text-gray-300">
                    {item.description}
                  </p>
                </div>
              </MotionWrapper>
            </div>
          ))
        }
      </div>
    </MotionWrapper>
  </section>

  {/* 獲獎與榮譽 */}
  <section class="container mx-auto px-6 lg:px-8 py-12">
    <MotionWrapper
      client:visible
      className="max-w-4xl"
      variants={containerVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true }}
    >
      <MotionWrapper
        client:visible
        type="h2"
        className="text-4xl font-bold text-gray-900 dark:text-white mb-12"
        variants={itemVariants}
      >
        🏆 獲獎與榮譽
      </MotionWrapper>
      <div class="grid md:grid-cols-2 gap-6">
        {
          awards.map((award, i) => (
            <MotionWrapper
              client:visible
              key={i}
              variants={itemVariants}
              className="bg-linear-to-br from-blue-50 to-blue-50 dark:from-blue-950/20 dark:to-blue-900/20 p-6 rounded-lg border border-blue-200 dark:border-blue-800"
            >
              <div class="flex items-start justify-between mb-3">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                  {award.title}
                </h3>
                <span class="text-sm text-blue-600 dark:text-blue-400 font-medium">
                  {award.year}
                </span>
              </div>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                {award.subtitle}
              </p>
              <p class="text-blue-600 dark:text-blue-400 font-semibold">
                {award.award}
              </p>
            </MotionWrapper>
          ))
        }
      </div>
    </MotionWrapper>
  </section>

  {/* 技術棧 */}
  <section class="container mx-auto px-6 lg:px-8 py-12">
    <MotionWrapper
      client:visible
      className="max-w-4xl"
      variants={containerVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true }}
    >
      <MotionWrapper
        client:visible
        type="h2"
        className="text-4xl font-bold text-gray-900 dark:text-white mb-12"
        variants={itemVariants}
      >
        技術棧
      </MotionWrapper>
      <div class="grid md:grid-cols-2 gap-6">
        {
          techStack.map((tech, i) => (
            <MotionWrapper
              client:visible
              key={i}
              variants={itemVariants}
              className="bg-gray-50 dark:bg-gray-900 p-6 rounded-lg border border-gray-200 dark:border-gray-800"
            >
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">
                {tech.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                {tech.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {tech.skills.map((skill) => (
                  <span class="px-3 py-1 bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-400 text-xs font-medium rounded-full">
                    {skill}
                  </span>
                ))}
              </div>
            </MotionWrapper>
          ))
        }
      </div>
    </MotionWrapper>
  </section>

  {/* 核心價值 */}
  <section class="container mx-auto px-6 lg:px-8 py-12">
    <MotionWrapper
      client:visible
      className="max-w-3xl mx-auto"
      variants={containerVariants}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true }}
    >
      <MotionWrapper
        client:visible
        type="h2"
        className="text-4xl font-bold text-gray-900 dark:text-white mb-8"
        variants={itemVariants}
      >
        核心價值
      </MotionWrapper>
      <MotionWrapper client:visible variants={itemVariants}>
        <div class="space-y-4">
          {
            [
              "💡 持續學習 - 關注最新技術趨勢與最佳實踐",
              "🎯 問題解決 - 透過代碼創造實際價值",
              "🤝 團隊協作 - 相信開放溝通與合作",
              "✨ 追求卓越 - 注重細節與使用者體驗",
            ].map((value, i) => (
              <div class="flex items-start gap-4 p-4 bg-gray-50 dark:bg-gray-900 rounded-lg">
                <span class="text-xl shrink-0">{value.split(" - ")[0]}</span>
                <div>
                  <p class="font-semibold text-gray-900 dark:text-white">
                    {value.split(" - ")[1]}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </MotionWrapper>
    </MotionWrapper>
  </section>
</PageLayout>
